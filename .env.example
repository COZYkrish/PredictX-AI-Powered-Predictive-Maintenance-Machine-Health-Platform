APP_NAME=PredictX
APP_ENV=development
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://user:pass@host:5432/predictx
TEST_DATABASE_URL=postgresql://user:pass@host:5432/predictx_test

# Authentication & Security
JWT_SECRET_KEY=your_secure_random_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","https://predictx.example.com"]

# Application Settings
LOG_LEVEL=INFO
TELEMETRY_RETENTION_DAYS=90
ML_MODE=real
ALERT_COOLDOWN_MINUTES=15

# Frontend Configuration (Used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
