APP_NAME=PredictX
APP_ENV=development
DEBUG=True
DATABASE_URL=postgresql://user:pass@host:5432/dbname
TEST_DATABASE_URL=postgresql://user:pass@host:5432/dbname_test
JWT_SECRET_KEY=generate_a_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://predictx.example.com"]
LOG_LEVEL=INFO
TELEMETRY_RETENTION_DAYS=90
ML_MODE=real
ALERT_COOLDOWN_MINUTES=15
